<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${empty pageTitle ? '云栖酒店 · 在线预订' : pageTitle}</title>
    <link rel="stylesheet" href="${ctx}/static/css/style.css">
</head>
<body>
<div class="navbar">
    <div class="container">
        <a class="brand" href="${ctx}/home">云栖酒店<span class="en">YUNQI HOTEL</span></a>
        <div class="nav-links">
            <a href="${ctx}/home" class="${active=='home'?'active':''}">首页</a>
            <a href="${ctx}/rooms" class="${active=='rooms'?'active':''}">房型预订</a>
            <c:if test="${not empty sessionScope.user}">
                <a href="${ctx}/orders" class="${active=='orders'?'active':''}">我的订单</a>
            </c:if>
            <c:if test="${sessionScope.user.role=='ADMIN'}">
                <a href="${ctx}/admin/dashboard">后台管理</a>
            </c:if>
        </div>
        <div class="nav-right">
            <c:choose>
                <c:when test="${empty sessionScope.user}">
                    <a href="${ctx}/auth?action=login" class="btn btn-ghost btn-sm">登录</a>
                    <a href="${ctx}/auth?action=register" class="btn btn-gold btn-sm">注册</a>
                </c:when>
                <c:otherwise>
                    <span class="hello">你好，
                        <c:out value="${empty sessionScope.user.realName ? sessionScope.user.username : sessionScope.user.realName}"/>
                    </span>
                    <a href="${ctx}/profile" style="color:#cdd8d8;font-size:14px;">个人中心</a>
                    <a href="${ctx}/auth?action=logout" class="btn btn-ghost btn-sm">退出</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</div>
